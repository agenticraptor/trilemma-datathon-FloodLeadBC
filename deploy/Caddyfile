# Automatic HTTPS (Let's Encrypt) for the sslip.io hostname in .env. No ACME email (none configured).
# /v1/*, /docs and /openapi.json go to the API; everything else is the static app in web/ (no build step).
{
	admin off
}

{$PUBLIC_HOSTNAME} {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	@api path /v1/* /docs /docs/* /openapi.json /redoc
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		# Strict CSP for the app: same-origin only, no inline script or style, no framing.
		# (Not applied to /docs, whose Swagger UI loads from a CDN.)
		header Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; object-src 'none'"
		header Cache-Control "no-cache"
		root * /srv/web
		file_server
	}

	log {
		output stdout
		format json
	}
}
